# All VITE_ values are PUBLIC (they are bundled into the browser app).
# Never put secrets or service-account credentials here.

# API Gateway base URL, no trailing slash. Example: https://my-gw-abc123.uc.gateway.dev
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_BASE_URL

# Identity Platform / Firebase web app settings (Console > Identity Platform > Application setup details)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base of the URLs encoded in certificate QR codes (must match the backend PUBLIC_VERIFICATION_BASE_URL)
VITE_PUBLIC_VERIFICATION_BASE_URL=http://localhost:5173/verify

# Client-side pre-check for PDF uploads; the backend limit (MAX_UPLOAD_SIZE_MB) is authoritative
VITE_MAX_UPLOAD_SIZE_MB=10

# true = run against built-in in-memory sample data, no backend or login needed (local UI preview only)
VITE_ENABLE_DEMO_MODE=false

# CORS option B (development only): true = call the API through the Vite dev proxy at /api
# instead of directly. Requires VITE_API_BASE_URL to be the real gateway URL.
VITE_DEV_PROXY=false
