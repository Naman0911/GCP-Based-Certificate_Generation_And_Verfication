# Copy to .env (never commit .env). Used by local runs and by scripts/*.sh.
# Locally the app uses Application Default Credentials:  gcloud auth application-default login

# --- Required ---------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
# Region used for Cloud Run functions, Cloud KMS, Storage and Firestore.
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)
GCS_BUCKET_NAME=your-project-id-certificates
KMS_KEY_RING=certificate-signing
KMS_KEY_NAME=certificate-signer
# Numeric version used for NEW signatures (created as 1 by scripts/create_kms_key.sh).
KMS_KEY_VERSION=1
IDENTITY_PLATFORM_PROJECT_ID=your-project-id
# Comma separated allow-list of administrator emails (must have a VERIFIED email).
# Alternative: grant the custom claim with scripts/grant_admin_claim.py.
ADMIN_EMAILS=admin@example.com
# Public verification page; the certificate ID is appended: <base>/<certificate_id>
PUBLIC_VERIFICATION_BASE_URL=https://certificates.example.com/verify
MAX_UPLOAD_SIZE_MB=10
SIGNED_URL_EXPIRATION_MINUTES=10
# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Optional ---------------------------------------------------------------
# Comma separated browser origins allowed to call the API (CORS). Empty = none.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Offline development ONLY: sign with an in-memory key instead of Cloud KMS.
# Forbidden when ENVIRONMENT=production and never packaged into deployments.
USE_LOCAL_DEV_SIGNER=false
# Local runs with user credentials: service account used to sign download URLs
# (you need roles/iam.serviceAccountTokenCreator on it). Not needed on Cloud Run.
SIGNED_URL_SERVICE_ACCOUNT=
# Unicode TrueType fonts for non-Latin recipient names in the PDF.
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# --- Deployment helpers (scripts only) ---------------------------------------
# Principal allowed to attach the runtime service accounts, e.g. user:you@example.com
DEPLOYER_MEMBER=
# API Gateway is only offered in some regions.
GATEWAY_LOCATION=us-central1
# Cap on concurrent instances per function (cost control).
MAX_INSTANCES=10
