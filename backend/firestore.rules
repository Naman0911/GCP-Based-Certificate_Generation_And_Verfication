rules_version = '2';

// All access goes through the backend (Admin SDK / service accounts, which are
// governed by IAM and bypass these rules). Browsers and mobile clients must
// never read or write Firestore directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
